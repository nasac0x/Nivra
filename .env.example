# Copie este arquivo para .env.local e preencha com os dados do SEU projeto Supabase.
# Sem este arquivo preenchido, o Nivra roda 100% local (localStorage) — nada quebra.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# (Opcional) Chave própria do Google Maps — sem ela, o app usa a chave demo embutida.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
